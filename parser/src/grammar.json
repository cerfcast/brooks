{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "mel",
  "rules": {
    "mel": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "list"
        },
        {
          "type": "SYMBOL",
          "name": "expr"
        }
      ]
    },
    "list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expr_list"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "expr_list": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "expr"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expr_list"
            },
            {
              "type": "STRING",
              "value": ","
            },
            {
              "type": "SYMBOL",
              "name": "expr"
            }
          ]
        }
      ]
    },
    "arguments": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "expr"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expr_list"
            },
            {
              "type": "STRING",
              "value": ","
            },
            {
              "type": "SYMBOL",
              "name": "expr"
            }
          ]
        }
      ]
    },
    "expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "grouped_expr"
        },
        {
          "type": "SYMBOL",
          "name": "simple_expr"
        }
      ]
    },
    "grouped_expr": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "expr"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "simple_expr": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "assignment_expr"
        },
        {
          "type": "SYMBOL",
          "name": "function_call_expr"
        },
        {
          "type": "SYMBOL",
          "name": "binary_expr"
        },
        {
          "type": "SYMBOL",
          "name": "prefix_expr"
        },
        {
          "type": "SYMBOL",
          "name": "literal_expr"
        }
      ]
    },
    "assignment_expr": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "SYMBOL",
          "name": "literal"
        }
      ]
    },
    "function_call_expr": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "arguments"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "binary_expr": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "expr"
          },
          {
            "type": "SYMBOL",
            "name": "binary_infix_operator"
          },
          {
            "type": "SYMBOL",
            "name": "expr"
          }
        ]
      }
    },
    "prefix_expr": {
      "type": "PREC_RIGHT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "prefix_operator"
          },
          {
            "type": "SYMBOL",
            "name": "expr"
          }
        ]
      }
    },
    "literal_expr": {
      "type": "SYMBOL",
      "name": "literal"
    },
    "literal": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string_literal"
        },
        {
          "type": "SYMBOL",
          "name": "number_literal"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[_a-zA-Z][_a-zA-Z\\.\\-\\#]+"
    },
    "number_literal": {
      "type": "PATTERN",
      "value": "[0-9]+"
    },
    "string_literal": {
      "type": "PATTERN",
      "value": "\"[a-z A-Z]*\""
    },
    "binary_infix_operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "logic_operator"
        },
        {
          "type": "SYMBOL",
          "name": "comparison_operator"
        },
        {
          "type": "SYMBOL",
          "name": "math_operator"
        },
        {
          "type": "SYMBOL",
          "name": "string_concat"
        }
      ]
    },
    "logic_operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "and"
        },
        {
          "type": "SYMBOL",
          "name": "or"
        }
      ]
    },
    "comparison_operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "binary_eq"
        },
        {
          "type": "SYMBOL",
          "name": "binary_lt"
        },
        {
          "type": "SYMBOL",
          "name": "binary_lte"
        },
        {
          "type": "SYMBOL",
          "name": "binary_gt"
        },
        {
          "type": "SYMBOL",
          "name": "binary_gte"
        }
      ]
    },
    "math_operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "math_plus"
        },
        {
          "type": "SYMBOL",
          "name": "math_minus"
        },
        {
          "type": "SYMBOL",
          "name": "math_mul"
        },
        {
          "type": "SYMBOL",
          "name": "math_div"
        }
      ]
    },
    "prefix_operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "plus"
        },
        {
          "type": "SYMBOL",
          "name": "minus"
        },
        {
          "type": "SYMBOL",
          "name": "bang"
        },
        {
          "type": "SYMBOL",
          "name": "uneg"
        }
      ]
    },
    "plus": {
      "type": "STRING",
      "value": "+"
    },
    "minus": {
      "type": "STRING",
      "value": "-"
    },
    "bang": {
      "type": "STRING",
      "value": "!"
    },
    "uneg": {
      "type": "STRING",
      "value": "~"
    },
    "and": {
      "type": "STRING",
      "value": "and"
    },
    "or": {
      "type": "STRING",
      "value": "or"
    },
    "string_concat": {
      "type": "STRING",
      "value": "."
    },
    "binary_eq": {
      "type": "STRING",
      "value": "=="
    },
    "binary_lt": {
      "type": "STRING",
      "value": "<"
    },
    "binary_lte": {
      "type": "STRING",
      "value": "<="
    },
    "binary_gt": {
      "type": "STRING",
      "value": ">"
    },
    "binary_gte": {
      "type": "STRING",
      "value": ">="
    },
    "math_plus": {
      "type": "STRING",
      "value": "+"
    },
    "math_minus": {
      "type": "STRING",
      "value": "-"
    },
    "math_mul": {
      "type": "STRING",
      "value": "*"
    },
    "math_div": {
      "type": "STRING",
      "value": "/"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}